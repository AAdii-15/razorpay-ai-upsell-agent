# Required: Razorpay Test Mode credentials (dashboard.razorpay.com -> Test Mode -> API Keys)
RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# LLM backend selection: "gemini" (default, free tier) or "claude"
LLM_BACKEND=gemini

# Required if LLM_BACKEND=gemini (aistudio.google.com -> Get API key, free, no card)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional override if the default model ID below 404s on your account/region
# GEMINI_MODEL=gemini-3.6-flash

# Required if LLM_BACKEND=claude (console.anthropic.com -> API Keys)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: enables X-API-Key auth on all mutating endpoints (/decide, /approve,
# /reject, /demo/simulate-failure). If unset, auth is off (local dev default).
# MERCHANT_API_KEY=generate_your_own_random_value_here
